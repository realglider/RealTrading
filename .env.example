# Login for the initial admin account. New users can register in the app.
# Generate APP_SECRET with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
ADMIN_EMAIL=
# Format: scrypt$<salt-hex>$<derived-key-hex>. Generate with scripts/hash-password.mjs.
ADMIN_PASSWORD_HASH=

# MySQL-compatible production database. Do not commit real credentials.
DATABASE_URL=mysql://user:password@host:3306/database

# Password reset mail via Resend. Verify a sender domain before using outside test mode.
RESET_EMAIL_API_KEY=
RESET_EMAIL_FROM=RealTrading <no-reply@example.com>
PUBLIC_APP_URL=https://your-app.example.com

# Google sign-in is not configured; email and password registration is available.
